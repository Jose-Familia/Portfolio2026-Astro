---
interface Entry { company: string; position: string; startDate: Date; endDate?: Date; current: boolean; description: string; }
interface Props { experience: Entry[]; lang: 'es' | 'en'; }
const { experience, lang } = Astro.props;
const english = lang === 'en';
const date = (value: Date) => value.toLocaleDateString(english ? 'en-US' : 'es-ES', { timeZone: 'UTC', month: 'short', year: 'numeric' });
---
{experience.length > 0 && (
  <section id="experiencia" class="scroll-mt-28" aria-labelledby="experience-title">
    <p class="text-sm uppercase tracking-widest text-subtle-ink mb-3">{english ? 'Professional background' : 'Trayectoria profesional'}</p>
    <h2 id="experience-title" class="text-3xl font-semibold tracking-tight mb-6">{english ? 'Work experience' : 'Experiencia laboral'}</h2>
    <div class="space-y-4">
      {experience.map(entry => (
        <article class="rounded-2xl border border-line bg-surface p-6 sm:p-7">
          <div class="flex items-start gap-4">
            <span class="flex items-center justify-center shrink-0 w-12 h-12 rounded-xl bg-accent-soft text-accent-ink" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="14" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12a25 25 0 0 0 18 0m-9 0v3"/></svg>
            </span>
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-3 mb-2">
                <h3 class="text-xl font-semibold">{entry.position}</h3>
                {entry.current && <span class="text-sm font-medium px-2.5 py-1 rounded-full bg-accent-soft text-accent-ink">{english ? 'Current' : 'Actual'}</span>}
              </div>
              <p class="font-medium text-accent-ink">{entry.company}</p>
              <p class="text-sm text-subtle-ink mt-2"><time datetime={entry.startDate.toISOString().slice(0,10)}>{date(entry.startDate)}</time> — {entry.current ? (english ? 'Present' : 'Presente') : entry.endDate ? date(entry.endDate) : ''}</p>
            </div>
          </div>
          <p class="text-muted-ink leading-relaxed mt-5">{entry.description}</p>
        </article>
      ))}
    </div>
  </section>
)}
