---
import ProfileTimeline from './ProfileTimeline.astro';
interface Entry { company: string; position: string; location?: string; startDate: Date; endDate?: Date; current: boolean; description: string; }
interface Props { experience: Entry[]; lang: 'es' | 'en'; }
const { experience, lang } = Astro.props;
---
<ProfileTimeline
  id="experiencia"
  title={lang === 'en' ? 'Work experience' : 'Experiencia laboral'}
  lang={lang}
  datePrecision="month"
  entries={experience.map(entry => ({ ...entry, title: entry.position, organization: entry.company }))}
/>
