---
/**
 * AuthorCard.astro
 * Tarjeta del autor para mostrar al final de artículos
 */

import Icon from '@/components/ui/Icon.astro';

// TODO: Obtener desde Keystatic settings
const author = {
  name: 'José Familia',
  bio: 'Estudiante de Ingeniería en Sistemas Computacionales en UNAPEC. Comparto apuntes y proyectos de desarrollo, bases de datos, cloud y tecnologías de la información.',
  social: {
    instagram: 'https://www.instagram.com/j.familia18',
    github: 'https://github.com/Jose-Familia',
  },
};
---

<div class="flex flex-col sm:flex-row gap-6 p-6 rounded-2xl bg-surface-alt border border-line">
  <!-- Info -->
  <div class="flex-1">
    <div class="flex items-center justify-between mb-2">
      <h3 class="text-lg font-semibold text-ink">
        {author.name}
      </h3>
      <div class="flex gap-2">
        <a
          href={author.social.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 text-neutral-500 hover:text-accent-ink transition-colors"
          aria-label="Instagram"
        >
          <Icon name="instagram" size={18} />
        </a>
        <a
          href={author.social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 text-neutral-500 hover:text-accent-ink transition-colors"
          aria-label="GitHub"
        >
          <Icon name="github" size={18} />
        </a>
      </div>
    </div>
    <p class="text-muted-ink">
      {author.bio}
    </p>
  </div>
</div>
