---
import { getCollection } from 'astro:content';
interface Props { currentSlug?: string; category?: string; }
const { currentSlug, category } = Astro.props;
const posts = await getCollection('blog', ({data}) => !data.draft);
const current = posts.find(post => post.slug === currentSlug);
const score = (post: typeof posts[number]) => Number(post.data.category === category) * 2 + post.data.tags.filter(tag => current?.data.tags.includes(tag)).length;
const related = posts.filter(post => post.slug !== currentSlug)
  .sort((a,b) => score(b) - score(a) || b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0,3);
---
{related.length > 0 && (
  <section aria-labelledby="related-posts-title">
    <h2 id="related-posts-title" class="text-2xl font-semibold mb-6">Para seguir explorando</h2>
    <div class="grid gap-5 md:grid-cols-3">
      {related.map(post => (
        <a href={`/blog/${post.slug}`} class="group block p-5 rounded-xl border border-neutral-200 dark:border-neutral-800 hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors">
          <p class="text-sm text-neutral-500 mb-3">{post.data.tags.slice(0,2).join(' · ') || 'Ingeniería y tecnología'}</p>
          <h3 class="font-semibold leading-snug mb-3">{post.data.title}</h3>
          <p class="text-sm text-neutral-500 line-clamp-3">{post.data.excerpt}</p>
        </a>
      ))}
    </div>
  </section>
)}
