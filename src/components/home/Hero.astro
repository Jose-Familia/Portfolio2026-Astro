---
import Button from '@/components/ui/Button.astro';
import TechTag from '@/components/ui/TechTag.astro';
interface Props {
  title: string;
  subtitle?: string;
  primaryCTA?: { text: string; link: string };
  secondaryCTA?: { text: string; link: string };
}
const { title, subtitle, primaryCTA, secondaryCTA } = Astro.props;
const areas = [
  { title: 'Interfaces', detail: 'Experiencias claras y accesibles', icon: 'react', technology: 'React' },
  { title: 'Backend', detail: 'Lógica, contratos y aplicaciones', icon: 'nestjs', technology: 'NestJS' },
  { title: 'Datos', detail: 'Modelado y persistencia', icon: 'postgresql', technology: 'PostgreSQL' },
  { title: 'Cloud', detail: 'Despliegue y arquitectura · en formación', icon: 'aws', technology: 'AWS' },
];
---
<section class="home-hero" aria-labelledby="hero-title">
  <div class="container-main hero-grid">
    <div class="hero-copy">
      <p class="eyebrow animate-fade-in-up">José Familia · Ingeniería en Sistemas</p>
      <h1 id="hero-title" class="hero-title animate-fade-in-up" style="--stagger:1">
        {title}<br /><em>aplicaciones</em><br />con propósito.
      </h1>
      {subtitle && <p class="hero-description animate-fade-in-up" style="--stagger:2">{subtitle}</p>}
      <div class="flex flex-wrap gap-3 mt-8 animate-fade-in-up" style="--stagger:3">
        {primaryCTA && <Button href={primaryCTA.link} size="lg">{primaryCTA.text}</Button>}
        {secondaryCTA && <Button href={secondaryCTA.link} variant="secondary" size="lg">{secondaryCTA.text}</Button>}
      </div>
      <p class="hero-location">Santo Domingo, República Dominicana</p>
    </div>
    <aside class="focus-panel animate-fade-in-up" style="--stagger:3" aria-labelledby="focus-panel-title">
      <div class="focus-panel-heading">
        <span class="eyebrow">Del diseño al despliegue</span>
        <span class="focus-symbol" aria-hidden="true">{ '{ }' }</span>
      </div>
      <h2 id="focus-panel-title">Las piezas que<br />me interesa conectar.</h2>
      <dl class="focus-areas">
        {areas.map(area => (
          <div class="focus-area">
            <div><dt>{area.title}</dt><dd>{area.detail}</dd></div>
            <TechTag name={area.technology} icon={area.icon} size="sm" />
          </div>
        ))}
      </dl>
      <p class="focus-panel-note">Aprendizaje continuo, proyectos propios y fundamentos de ingeniería.</p>
    </aside>
  </div>
</section>
