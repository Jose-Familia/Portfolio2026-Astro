---
/**
 * Hero.astro
 * Sección hero principal para la página de inicio
 * Diseño minimalista con animaciones sutiles
 */

import Button from '@/components/ui/Button.astro';

export interface Props {
  title: string;
  subtitle?: string;
  primaryCTA?: {
    text: string;
    link: string;
  };
  secondaryCTA?: {
    text: string;
    link: string;
  };
}

const { title, subtitle, primaryCTA, secondaryCTA } = Astro.props;
---

<section class="relative min-h-[85vh] flex items-center overflow-hidden dark:bg-canvas">
  <!-- Fondo con gradiente sutil -->
  <div class="absolute inset-0 -z-10">
    <!-- Fondo en modo claro con gradiente -->
    <div class="absolute inset-0 bg-gradient-to-br from-neutral-50 via-white to-neutral-100/50 dark:hidden"></div>
    <!-- Fondo sólido en modo oscuro -->
    <div class="absolute inset-0 hidden dark:block bg-canvas"></div>
    <!-- Patrón de puntos decorativo -->
    <div class="absolute inset-0 opacity-[0.02] dark:hidden" style="background-image: radial-gradient(circle, currentColor 1px, transparent 1px); background-size: 32px 32px;"></div>
    <!-- Efecto de gradiente animado -->
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-neutral-200/30 rounded-full blur-3xl dark:hidden"></div>
    <div class="absolute bottom-0 right-1/4 w-80 h-80 bg-neutral-200/20 rounded-full blur-3xl dark:hidden" style="animation-delay: 1s"></div>
  </div>
  
  <div class="container-main py-20 md:py-32">
    <div class="max-w-4xl">
      <p class="text-sm uppercase tracking-[.16em] text-subtle-ink mb-8 animate-fade-in-up">
        José Familia · Desarrollo de aplicaciones
      </p>
      <!-- Título principal -->
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight mb-6 text-ink animate-fade-in-up">
        {title}
      </h1>
      
      <!-- Subtítulo -->
      {subtitle && (
        <p class="text-xl md:text-2xl text-muted-ink max-w-2xl mb-10 animate-fade-in-up" style="--stagger: 2">
          {subtitle}
        </p>
      )}
      
      <!-- CTAs -->
      <div class="flex flex-wrap gap-4 animate-fade-in-up" style="--stagger: 3">
        {primaryCTA && (
          <Button href={primaryCTA.link} variant="primary" size="lg">
            {primaryCTA.text}
          </Button>
        )}
        {secondaryCTA && (
          <Button href={secondaryCTA.link} variant="secondary" size="lg">
            {secondaryCTA.text}
          </Button>
        )}
      </div>
      
    </div>
  </div>
</section>
 
