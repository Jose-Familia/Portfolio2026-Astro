---
export interface Props { images: string[]; projectName: string; }
const { images, projectName } = Astro.props;
---
<project-gallery class="block" data-project-name={projectName}>
  <div class="grid gap-4 sm:grid-cols-2">
    {images.map((image, index) => (
      <button type="button" class="group overflow-hidden rounded-xl border border-line cursor-zoom-in focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4" data-gallery-image={image} aria-label={`Ampliar captura ${index + 1} de ${projectName}`}>
        <img src={image} alt={`${projectName}, captura ${index + 1}`} class="w-full aspect-video object-cover transition-transform duration-300 group-hover:scale-[1.02]" loading="lazy" />
      </button>
    ))}
  </div>
  <dialog class="gallery-dialog fixed inset-0 w-[96vw] max-w-6xl max-h-[94dvh] rounded-2xl p-4 bg-neutral-950 text-white" aria-label={`Capturas de ${projectName}`}>
    <div class="flex items-center justify-between gap-4 mb-4">
      <p data-gallery-caption aria-live="polite"></p>
      <button class="px-4 py-2 rounded-lg border border-neutral-600" type="button" data-gallery-close autofocus>Cerrar</button>
    </div>
    <img data-gallery-large alt="" class="w-full max-h-[70dvh] object-contain" />
    <div class="flex justify-between gap-4 mt-4">
      <button class="px-4 py-2 rounded-lg border border-neutral-600" type="button" data-gallery-prev>Anterior</button>
      <button class="px-4 py-2 rounded-lg border border-neutral-600" type="button" data-gallery-next>Siguiente</button>
    </div>
  </dialog>
</project-gallery>
<style>dialog::backdrop { background: rgb(0 0 0 / .8); }</style>
<script>
  class ProjectGallery extends HTMLElement {
    connectedCallback() {
      if (this.dataset.initialized) return;
      this.dataset.initialized = 'true';
      const dialog = this.querySelector('dialog')!;
      const image = this.querySelector<HTMLImageElement>('[data-gallery-large]')!;
      const buttons = [...this.querySelectorAll<HTMLButtonElement>('[data-gallery-image]')];
      let current = 0;
      let trigger: HTMLButtonElement | undefined;
      const show = (index: number) => {
        current = (index + buttons.length) % buttons.length;
        image.src = buttons[current].dataset.galleryImage!;
        image.alt = `${this.dataset.projectName}, captura ${current + 1}`;
        this.querySelector('[data-gallery-caption]')!.textContent = `${this.dataset.projectName} · ${current + 1} / ${buttons.length}`;
      };
      buttons.forEach((button, index) => button.addEventListener('click', () => {
        trigger = button; show(index); dialog.showModal();
      }));
      this.querySelector('[data-gallery-close]')!.addEventListener('click', () => dialog.close());
      this.querySelector('[data-gallery-prev]')!.addEventListener('click', () => show(current - 1));
      this.querySelector('[data-gallery-next]')!.addEventListener('click', () => show(current + 1));
      dialog.addEventListener('keydown', event => {
        if (event.key === 'ArrowLeft') { event.preventDefault(); show(current - 1); }
        if (event.key === 'ArrowRight') { event.preventDefault(); show(current + 1); }
      });
      dialog.addEventListener('click', event => {
        const box = dialog.getBoundingClientRect();
        if (event.target === dialog && (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom)) dialog.close();
      });
      dialog.addEventListener('close', () => trigger?.focus());
    }
  }
  if (!customElements.get('project-gallery')) customElements.define('project-gallery', ProjectGallery);
</script>
