---
import { getTechLogo } from '@/utils/techLogos';
export interface Props {
  name: string; icon: string; url?: string; size?: 'sm' | 'md'; class?: string;
  style?: string | Record<string, string | number>;
}
const { name, icon, url, size = 'md', class: className = '', style } = Astro.props;
const logo = getTechLogo(icon);
const dual = Boolean(logo?.light && logo?.dark);
const source = logo?.single || logo?.light || logo?.dark;
const Tag = url ? 'a' : 'span';
const styleAttribute = typeof style === 'object' ? Object.entries(style).map(([key,value]) => `${key}: ${value}`).join('; ') : style;
---
<Tag href={url} target={url ? '_blank' : undefined} rel={url ? 'noopener noreferrer' : undefined} class:list={['tech-tag', `tech-tag--${size}`, className]} style={styleAttribute}>
  {source && (
    <span class:list={['tech-icon', logo?.backplate && 'tech-icon--plate']} aria-hidden="true">
      {dual ? (
        <>
          <img class="tech-image--light" src={logo!.light} alt="" width="24" height="24" loading="lazy" decoding="async" />
          <img class="tech-image--dark" src={logo!.dark} alt="" width="24" height="24" loading="lazy" decoding="async" />
        </>
      ) : <img src={source} alt="" width="24" height="24" loading="lazy" decoding="async" />}
    </span>
  )}
  <span class="font-medium">{name}</span>
</Tag>
<style>
  .tech-tag { display: inline-flex; align-items: center; gap: .625rem; border: 1px solid rgb(var(--color-border)); border-radius: 999px; background: rgb(var(--color-surface-alt)); color: rgb(var(--color-foreground)); transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease; }
  .tech-tag--md { padding: .5rem .875rem; font-size: .875rem; }
  .tech-tag--sm { padding: .25rem .625rem; font-size: .875rem; }
  a.tech-tag:hover { border-color: rgb(var(--color-accent)); }
  .tech-icon { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; width: 24px; height: 24px; padding: 1px; border-radius: 6px; }
  .tech-tag--sm .tech-icon { width: 18px; height: 18px; }
  .tech-icon img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .tech-icon--plate { background: #f8fafc; padding: 3px; }
  .tech-icon .tech-image--dark { display: none; }
  :global(.dark) .tech-icon .tech-image--light { display: none; }
  :global(.dark) .tech-icon .tech-image--dark { display: block; }
</style>
