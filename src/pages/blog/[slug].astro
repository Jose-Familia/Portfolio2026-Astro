---
/**
 * Página individual de blog post
 * Ruta dinámica: /blog/[slug]
 */

import BlogPostLayout from '@/layouts/BlogPostLayout.astro';
import { estimateReadingTime } from '@/utils/readingTime';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

const readingTime = post.data.readingTime || estimateReadingTime(post.body);
---

<BlogPostLayout
  title={post.data.title}
  slug={post.slug}
  excerpt={post.data.excerpt}
  publishDate={post.data.publishDate}
  updatedDate={post.data.updatedDate}
  coverImage={post.data.coverImage}
  category={post.data.category}
  tags={post.data.tags || []}
  readingTime={readingTime}
  headings={headings}
  metaTitle={post.data.seo?.metaTitle}
  metaDescription={post.data.seo?.metaDescription}
  canonicalUrl={post.data.seo?.canonicalUrl}
>
  <Content />
</BlogPostLayout>
