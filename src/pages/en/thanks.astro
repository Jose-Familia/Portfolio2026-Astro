---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';

const title = 'Thanks for reaching out';
---

<BaseLayout title={title} description="Your message was sent successfully. I will get back to you soon." lang="en">
  <section class="section-sm">
    <div class="container-main max-w-2xl text-center">
      <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-green-100 text-green-700 dark:bg-green-950/40 dark:text-green-300" aria-hidden="true">
        <span class="text-3xl">✓</span>
      </div>
      <h1 class="mb-4 text-4xl font-bold tracking-tight">{title}</h1>
      <p class="mb-8 text-lg text-neutral-600 dark:text-neutral-400">
        I received your message and will get back to you as soon as possible.
      </p>
      <Button href="/" variant="primary">Back home</Button>
    </div>
  </section>
</BaseLayout>