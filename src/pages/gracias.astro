---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';

const title = 'Gracias por escribirme';
---

<BaseLayout title={title} description="Tu mensaje fue enviado correctamente. Te responderé lo antes posible.">
  <section class="section-sm">
    <div class="container-main max-w-2xl text-center">
      <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-green-100 text-green-700 dark:bg-green-950/40 dark:text-green-300" aria-hidden="true">
        <span class="text-3xl">✓</span>
      </div>
      <h1 class="mb-4 text-4xl font-bold tracking-tight">{title}</h1>
      <p class="mb-8 text-lg text-neutral-600 dark:text-neutral-400">
        Recibí tu mensaje y me pondré en contacto contigo lo antes posible.
      </p>
      <Button href="/" variant="primary">Volver al inicio</Button>
    </div>
  </section>
</BaseLayout>