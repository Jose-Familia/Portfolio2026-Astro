---
import Hero from '@/components/home/Hero.astro';
import TechTag from '@/components/ui/TechTag.astro';
import Button from '@/components/ui/Button.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { aboutContent } from '@/i18n/about';
import { estimateReadingTime } from '@/utils/readingTime';
import { formatDateShort } from '@/utils/formatDate';
const allProjects = await getCollection('projects');
const featuredProjects = allProjects.filter(project => project.data.featured)
  .sort((a,b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()).slice(0,4);
const posts = (await getCollection('blog')).filter(post => !post.data.draft);
const recentPosts = [...posts].sort((a,b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()).slice(0,3);
const technologies = [
  {name:'TypeScript',icon:'typescript'}, {name:'React',icon:'react'}, {name:'Next.js',icon:'nextjs'},
  {name:'Astro',icon:'astro'}, {name:'Node.js',icon:'nodejs'}, {name:'NestJS',icon:'nestjs'},
  {name:'PostgreSQL',icon:'postgresql'}, {name:'Docker',icon:'docker'},
];
---
<BaseLayout title="Inicio">
  <Hero
    title="Diseño y desarrollo"
    subtitle="Soy José Familia, estudiante de Ingeniería en Sistemas Computacionales en UNAPEC. Construyo aplicaciones web y de escritorio, y profundizo en backend, datos y cloud."
    primaryCTA={{text:'Explorar proyectos',link:'/proyectos'}}
    secondaryCTA={{text:'Conocer mi perfil',link:'/sobre-mi'}}
  />
  <div class="container-main">
    <nav class="portfolio-overview" aria-label="Explorar el portfolio">
      <a href="/proyectos"><span class="overview-value">{allProjects.length} proyectos</span><span>Código y decisiones técnicas</span></a>
      <a href="/blog"><span class="overview-value">{posts.length} artículos</span><span>Apuntes para construir mejor</span></a>
      <a href="/sobre-mi#formacion"><span class="overview-value">UNAPEC</span><span>Ingeniería en Sistemas</span></a>
      <a href="/sobre-mi#certificaciones"><span class="overview-value">{aboutContent.es.certifications.length} credenciales</span><span>Desarrollo y bases de datos</span></a>
    </nav>
  </div>
  <section id="about" class="editorial-section">
    <div class="container-main">
      <div class="intro-grid">
        <div class="animate-fade-in-up"><p class="eyebrow mb-5">Formación y enfoque</p><h2 class="section-display">Entender el sistema.<br /><em>Cuidar cada detalle.</em></h2></div>
        <div class="intro-copy animate-fade-in-up">
          <p>Mi formación en Ingeniería en Sistemas Computacionales es el punto de partida. Me interesa diseñar aplicaciones útiles y comprender cómo se conectan sus interfaces, su lógica y sus datos.</p>
          <p>Aprendo construyendo: proyectos web y de escritorio, práctica en backend y exploración de cloud e infraestructura. Documento las decisiones, los problemas y lo que descubro en el camino.</p>
          <a href="/sobre-mi" class="editorial-link">Formación, experiencia y habilidades</a>
        </div>
      </div>
      <div class="stack-strip animate-fade-in-up"><p class="eyebrow">Tecnologías que utilizo</p><div class="flex flex-wrap gap-2">{technologies.map(tech=><TechTag name={tech.name} icon={tech.icon} size="md" />)}</div></div>
    </div>
  </section>
  {featuredProjects.length > 0 && (
    <section class="editorial-section" aria-labelledby="selected-projects-title">
      <div class="container-main">
        <header class="editorial-section-heading animate-fade-in-up">
          <div><p class="eyebrow mb-4">Del problema a la implementación</p><h2 id="selected-projects-title" class="section-display">Proyectos seleccionados</h2></div>
          <a href="/proyectos" class="editorial-link">Ver todos los proyectos</a>
        </header>
        <div class="grid md:grid-cols-2 gap-8">
          {featuredProjects.map((project,index)=>(
            <a href={`/proyectos/${project.slug}`} class="home-project group animate-fade-in-up" style={`--stagger:${index}`}>
              <div class="home-project-cover">{project.data.thumbnail && <img src={project.data.thumbnail} alt={`Vista previa de ${project.data.title}`} width="1440" height="900" loading="lazy" decoding="async" />}</div>
              <div class="home-project-content"><p class="eyebrow mb-3">{project.data.technologies.slice(0,3).join(' · ')}</p><h3>{project.data.title}</h3><p>{project.data.description}</p><span class="editorial-link">Explorar proyecto</span></div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
  {recentPosts.length > 0 && (
    <section class="editorial-section" aria-labelledby="recent-articles-title">
      <div class="container-main">
        <header class="editorial-section-heading animate-fade-in-up"><div><p class="eyebrow mb-4">Notas de ingeniería</p><h2 id="recent-articles-title" class="section-display">Lo que voy aprendiendo</h2></div><a href="/blog" class="editorial-link">Explorar el blog</a></header>
        <div class="home-articles">
          {recentPosts.map((post,index)=>(
            <a href={`/blog/${post.slug}`} class="home-article animate-fade-in-up" style={`--stagger:${index}`}>
              {post.data.coverImage && <img src={post.data.coverImage} alt="" width="1440" height="900" loading="lazy" decoding="async" />}
              <div><p class="article-meta"><time datetime={post.data.publishDate.toISOString().slice(0,10)}>{formatDateShort(post.data.publishDate)}</time><span>{post.data.readingTime || estimateReadingTime(post.body)} min de lectura</span></p><h3>{post.data.title}</h3><p class="article-excerpt">{post.data.excerpt}</p></div>
              <span class="article-read">Leer artículo</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
  <section class="contact-band" aria-labelledby="home-contact-title"><div class="container-main contact-band-grid">
    <div><p class="eyebrow mb-5">Conversemos</p><h2 id="home-contact-title" class="section-display">Las buenas ideas<br />empiezan con <em>una conversación.</em></h2></div>
    <div><p>Me interesan las colaboraciones y oportunidades en desarrollo de aplicaciones, backend y cloud. Cuéntame qué estás construyendo.</p><div class="flex flex-wrap gap-3 mt-7"><Button href="/contacto" size="lg">Hablemos de tu proyecto</Button><a href="mailto:familiajoserene@gmail.com" class="editorial-link self-center">Enviar email</a></div></div>
  </div></section>
</BaseLayout>
